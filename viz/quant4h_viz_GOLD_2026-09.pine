swingHigh = array.from<float>(4688.00, 4688.00, 4688.00, 4688.00, 4688.00, 4688.00, 4688.00, 4688.00, 4688.00, 4688.00, 4688.00, 4688.00, 4688.00, 4688.00, 4688.00, 4688.00, 4688.00, 4688.00, 4688.00, 4558.50, 4558.50, 4558.50, 4558.50, 4537.80, 4537.80, 4537.80, 4537.80, 4537.80, 4537.80, 4537.80, 4537.80, 4537.80, 4537.80, 4537.80, 4537.80, 4479.00, 4479.00, 4479.00, 4479.00, 4479.00, 4479.90, 4479.90, 4479.90, 4479.90, 4479.90, 4479.90, 4479.90, 4479.90, 4479.90, 4479.90, 4479.90, 4479.90, 4479.90, 4479.90, 4479.90, 4479.90, 4479.90, 4479.90, 4479.90, 4479.90, 4479.90)
