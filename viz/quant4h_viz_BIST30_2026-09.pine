// ---- PAYLOAD-END

var int[]   m_ts   = array.new<int>()
var float[] m_ema  = array.new<float>()
var float[] m_stop = array.new<float>()
var float[] m_swl  = array.new<float>()
var float[] m_swh  = array.new<float>()
var float[] m_dh   = array.new<float>()
var float[] m_dl   = array.new<float>()
var int[]   m_sigL = array.new<int>()
var int[]   m_sigS = array.new<int>()
if barstate.isfirst and payloadOK
    m_ts   := f_ts()
    m_ema  := f_ema200()
    m_stop := f_stopLong()
    m_swl  := f_swingLow()
    m_swh  := f_swingHigh()
    m_dh   := f_donHigh()
    m_dl   := f_donLow()
    m_sigL := f_sigLong()
    m_sigS := f_sigShort()

hasPayload = payloadOK and array.size(m_ts) > 1

idx = -1
if hasPayload
    for i = 0 to array.size(m_ts) - 1
        if array.get(m_ts, i) == time
            idx := i
            break
f_val(array<float> a) =>
    hasPayload and idx >= 0 ? array.get(a, idx) : na
emaVal  = f_val(m_ema)
stopVal = f_val(m_stop)
swlVal  = f_val(m_swl)
swhVal  = f_val(m_swh)
dhVal   = f_val(m_dh)
dlVal   = f_val(m_dl)
sigL    = hasPayload and idx >= 0 ? array.get(m_sigL, idx) : 0
sigS    = hasPayload and idx >= 0 ? array.get(m_sigS, idx) : 0

plot(show_ema ? emaVal : na,     "EMA200 (ihraç)",      color = color.new(color.orange, 0), linewidth = 2)
plot(show_levels ? stopVal : na, "stop_long",           color = color.new(color.red, 25),   linewidth = 1, style = plot.style_stepline)
plot(show_levels ? swlVal : na,  "swing_low",           color = color.new(color.green, 50), linewidth = 1, style = plot.style_stepline)
plot(show_levels ? swhVal : na,  "swing_high",          color = color.new(color.teal, 50),  linewidth = 1, style = plot.style_stepline)
plot(show_levels ? dhVal : na,   "donchian_high(20)",   color = color.new(color.gray, 60),  linewidth = 1, style = plot.style_circles)
plot(show_levels ? dlVal : na,   "donchian_low(20)",    color = color.new(color.gray, 60),  linewidth = 1, style = plot.style_circles)
plotshape(sigL == 1 ? close : na, "AL koşulu oluştu (sinyal kaydı)", shape.triangleup, location.absolute, color.new(color.lime, 0), size = size.tiny)
plotshape(sigS == 1 ? close : na, "SAT koşulu (sinyal kaydı)",       shape.xcross,     location.absolute, color.new(color.red, 0),  size = size.tiny)

// ---- SABİT banner ----
var table bn = table.new(position.top_right, 1, 3, border_width = 1)
if barstate.islastconfirmedhistory
    table.cell(bn, 0, 0, "quant4h watch_only viz v4 — UNTESTED-VIZ", text_color = color.white, bgcolor = color.new(color.red, 25), text_size = size.small)
    table.cell(bn, 0, 1, hasPayload ? payloadMeta : "⚠ " + payloadMeta, text_color = hasPayload ? color.silver : color.yellow, bgcolor = color.new(color.black, 40), text_size = size.tiny)
    table.cell(bn, 0, 2, "trade YOK · emir YOK · tavsiye YOK · marker'lar SİNYAL kaydıdır · doğruluk kaynağı DEĞİL", text_color = color.silver, bgcolor = color.new(color.black, 40), text_size = size.tiny)
