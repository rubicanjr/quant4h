        m_sigPx := array.copy(a0_sigPrice)
        m_trETs := array.copy(a0_trETs)
        m_trEPx := array.copy(a0_trEPx)
        m_trXTs := array.copy(a0_trXTs)
        m_trXPx := array.copy(a0_trXPx)
        m_trR := array.copy(a0_trR)
    else if active == 1
        m_ts := array.copy(a1_ts)
        m_ema := array.copy(a1_ema200)
        m_stop := array.copy(a1_stopLong)
        m_swl := array.copy(a1_swingLow)
        m_swh := array.copy(a1_swingHigh)
        m_dh := array.copy(a1_donHigh)
        m_dl := array.copy(a1_donLow)
        m_sigL := array.copy(a1_sigLong)
        m_sigS := array.copy(a1_sigShort)
        m_sigPx := array.copy(a1_sigPrice)
        m_trETs := array.copy(a1_trETs)
        m_trEPx := array.copy(a1_trEPx)
        m_trXTs := array.copy(a1_trXTs)
        m_trXPx := array.copy(a1_trXPx)
        m_trR := array.copy(a1_trR)
    else if active == 2
        m_ts := array.copy(a2_ts)
        m_ema := array.copy(a2_ema200)
        m_stop := array.copy(a2_stopLong)
        m_swl := array.copy(a2_swingLow)
        m_swh := array.copy(a2_swingHigh)
        m_dh := array.copy(a2_donHigh)
        m_dl := array.copy(a2_donLow)
        m_sigL := array.copy(a2_sigLong)
        m_sigS := array.copy(a2_sigShort)
        m_sigPx := array.copy(a2_sigPrice)
        m_trETs := array.copy(a2_trETs)
        m_trEPx := array.copy(a2_trEPx)
        m_trXTs := array.copy(a2_trXTs)
        m_trXPx := array.copy(a2_trXPx)
        m_trR := array.copy(a2_trR)
    else if active == 3
        m_ts := array.copy(a3_ts)
        m_ema := array.copy(a3_ema200)
        m_stop := array.copy(a3_stopLong)
        m_swl := array.copy(a3_swingLow)
        m_swh := array.copy(a3_swingHigh)
        m_dh := array.copy(a3_donHigh)
        m_dl := array.copy(a3_donLow)
        m_sigL := array.copy(a3_sigLong)
        m_sigS := array.copy(a3_sigShort)
        m_sigPx := array.copy(a3_sigPrice)
        m_trETs := array.copy(a3_trETs)
        m_trEPx := array.copy(a3_trEPx)
        m_trXTs := array.copy(a3_trXTs)
        m_trXPx := array.copy(a3_trXPx)
        m_trR := array.copy(a3_trR)
hasPayload = active >= 0 and array.size(m_ts) > 1
hasTrades  = active >= 0 and active != 3 and array.size(m_trETs) > 0

// ---- seviye/ema indeksi (M9c deseni) ----
idx = -1
if hasPayload
    for i = 0 to array.size(m_ts) - 1
        if array.get(m_ts, i) == time
            idx := i
            break
f_val(array<float> a) =>
    hasPayload and idx >= 0 ? array.get(a, idx) : na
emaVal  = f_val(m_ema)
stopVal = f_val(m_stop)
swlVal  = f_val(m_swl)
swhVal  = f_val(m_swh)
dhVal   = f_val(m_dh)
dlVal   = f_val(m_dl)
sigL    = hasPayload and idx >= 0 ? array.get(m_sigL, idx) : 0
sigS    = hasPayload and idx >= 0 ? array.get(m_sigS, idx) : 0
sigPx   = f_val(m_sigPx)

plot(show_ema and not simple_mode ? emaVal : na,   "EMA200 (ihraç)",      color = color.new(color.orange, 0), linewidth = 2)
plot(show_levels and not simple_mode ? stopVal : na, "stop_long",         color = color.new(color.red, 25),   linewidth = 1, style = plot.style_stepline)
plot(show_levels and not simple_mode ? swlVal : na,  "swing_low",         color = color.new(color.green, 50), linewidth = 1, style = plot.style_stepline)
plot(show_levels and not simple_mode ? swhVal : na,  "swing_high",        color = color.new(color.teal, 50),  linewidth = 1, style = plot.style_stepline)
plot(show_levels and not simple_mode ? dhVal : na,   "donchian_high(20)", color = color.new(color.gray, 60),  linewidth = 1, style = plot.style_circles)
plot(show_levels and not simple_mode ? dlVal : na,   "donchian_low(20)",  color = color.new(color.gray, 60),  linewidth = 1, style = plot.style_circles)

// ---- TRADE-REVIEW: giriş/çıkış işaretçileri (sıralı diziler, O(1) amortize) ----
var int   ePtr = 0
var int   xPtr = 0
var float cumR = 0.0
entryPx = na
exitPx  = na
exitR   = na
if hasTrades
    if ePtr < array.size(m_trETs) and array.get(m_trETs, ePtr) == time
        entryPx := array.get(m_trEPx, ePtr)
        ePtr += 1
    if xPtr < array.size(m_trXTs) and array.get(m_trXTs, xPtr) == time
        exitPx := array.get(m_trXPx, xPtr)
        exitR  := array.get(m_trR, xPtr)
        cumR  += exitR
        xPtr  += 1
plotshape(not na(entryPx) ? entryPx : na, "AL koşulu oluştu (sinyal kaydı)", shape.triangleup, location.absolute, color.new(color.lime, 0), size = size.tiny)
plotshape(not na(exitPx) ? exitPx : na,  "SAT koşulu (sinyal kaydı)",        shape.xcross,     location.absolute, color.new(color.red, 0),  size = size.tiny)
if show_trades and not na(exitPx)
    label.new(bar_index, exitPx, str.tostring(exitR, "#.##") + "R", style = label.style_none, textcolor = color.new(color.silver, 10), size = size.tiny)
plot(show_trades ? cumR : na, "kümülatif R (trade sırası)", color = color.new(color.aqua, 30), linewidth = 1, style = plot.style_stepline, scale = scale.none)

// ---- sinyal marker'ları (SADE MOD'da gizli) ----
plotshape(not simple_mode and sigL == 1 ? sigPx : na, "final LONG (capped)",  shape.triangleup,   location.absolute, color.new(color.green, 40), size = size.tiny)
plotshape(not simple_mode and sigS == 1 ? sigPx : na, "final SHORT (capped)", shape.triangledown, location.absolute, color.new(color.maroon, 40), size = size.tiny)

// ---- SABİT banner ----
var table bn = table.new(position.top_right, 1, 4, border_width = 1)
if barstate.islastconfirmedhistory
    table.cell(bn, 0, 0, "quant4h watch_only MULTI v2 — UNTESTED-VIZ", text_color = color.white, bgcolor = color.new(color.red, 25), text_size = size.small)
    table.cell(bn, 0, 1, active >= 0 ? "payload: " + (active == 0 ? "BTC" : active == 1 ? "GOLD" : active == 2 ? "SILVER" : "BIST30-endeks") + " · trade-review: " + (hasTrades ? "VAR" : "YOK") : "⚠ PAYLOAD YOK — bu sembol için gömülü payload yok (BTCUSDT/GC1!/SI1!/XU030)", text_color = active >= 0 ? color.silver : color.yellow, bgcolor = color.new(color.black, 40), text_size = size.tiny)
    table.cell(bn, 0, 2, "trade YOK · emir YOK · tavsiye YOK · marker'lar backtest KAYIDIDIR", text_color = color.silver, bgcolor = color.new(color.black, 40), text_size = size.tiny)
    table.cell(bn, 0, 3, "doğruluk kaynağı DEĞİL · payload ufku: son --fetch'li §A koşusu", text_color = color.silver, bgcolor = color.new(color.black, 40), text_size = size.tiny)
