// ---- master diziler: aktif bloğu ilk barda kopyala ----
var int[]   m_ts   = array.new<int>()
var float[] m_ema  = array.new<float>()
var float[] m_stop = array.new<float>()
var float[] m_swl  = array.new<float>()
var float[] m_swh  = array.new<float>()
var float[] m_dh   = array.new<float>()
var float[] m_dl   = array.new<float>()
var int[]   m_sigL = array.new<int>()
var int[]   m_sigS = array.new<int>()
var float[] m_sigPx= array.new<float>()
var int[]   m_trETs  = array.new<int>()
var float[] m_trEPx  = array.new<float>()
var int[]   m_trXTs  = array.new<int>()
var float[] m_trXPx  = array.new<float>()
var float[] m_trR    = array.new<float>()
if barstate.isfirst
    if active == 0
        m_ts := array.copy(a0_ts)
        m_ema := array.copy(a0_ema200)
        m_stop := array.copy(a0_stopLong)
        m_swl := array.copy(a0_swingLow)
        m_swh := array.copy(a0_swingHigh)
        m_dh := array.copy(a0_donHigh)
        m_dl := array.copy(a0_donLow)
