//@version=5
// ============================================================================
// quant4h — watch_only viz MULTI v2 (M14, 2026-09-18, kullanıcı onaylı)
//
// TEK dosya, 4 gömülü payload bloğu + syminfo.ticker eşlemesi:
//   BTC   -> BTCUSDT (Binance spot)   GOLD -> GC1!/GC=F/XAUUSD
//   SILVER-> SI1!/SI=F/XAGUSD        BIST30 endeks -> XU030
// Eşleşmeyen sembolde çizim YOK + "payload yok" banner'ı.
//
// SADE MOD VARSAYILAN: yalnız giriş/çıkış marker'ları
//   ▲ giriş = "AL koşulu oluştu (sinyal kaydı)"   ✖ çıkış = "SAT koşulu (sinyal kaydı)"
//   (bunlar BACKTEST TRADE KAYITLARIDIR — canlı sinyal/öneri DEĞİLDİR)
// EMA200/seviyeler input.toggle ile KAPALI-açılır. UNTESTED-VIZ + watch_only
// banner'ı SABİT (kapatılamaz). strategy() YOK · alert YOK · Pine'da HESAP YOK:
// trade çiftleri/R etiketleri/kümülatif R Python backtest'inden (capped P0xA0,
// reports/trades_*.csv) GÖMÜLÜDÜR.
//
// PAYLOAD UFKU: bu dosya her --fetch'li cadence/§A koşusunda yenilenir
// (ops_runbook §A-cadence "viz tazeleme"); eski tarihli dosya = eski veri.
// DOĞRULUK KAYNAĞI DEĞİLDİR (UNTESTED-VIZ) — kaynak: repo raporları/parquet'leri.
// BIST30 bloğunda TRADE-REVIEW YOKTUR (endeks trade edilmez; sepet trade'leri
// hisse bazındadır, tek grafiğe eşlenemez).
// ============================================================================
indicator("quant4h watch_only viz MULTI v2 [UNTESTED-VIZ]", overlay = true, max_labels_count = 500, max_lines_count = 100)

simple_mode = input.bool(true,  "SADE MOD: yalniz giris/cikis marker'lari", group = "quant4h")
show_ema    = input.bool(false, "EMA200 (ihraç seri)", group = "quant4h")
show_levels = input.bool(false, "Yapisal seviyeler (swing/Donchian/stop)", group = "quant4h")
show_trades = input.bool(false, "TRADE-REVIEW: R etiketleri + kumilatif R", group = "quant4h")

// ---- sembol eşlemesi ----
tk     = syminfo.ticker
isBTC  = tk == "BTCUSDT" or tk == "BTCUSDT.BINANCE" or tk == "BINANCE:BTCUSDT"
isGOLD = tk == "GC1!" or tk == "GC=F" or tk == "XAUUSD" or tk == "GOLD"
isSILV = tk == "SI1!" or tk == "SI=F" or tk == "XAGUSD" or tk == "SILVER"
isBIST = tk == "XU030" or tk == "XU030.IS"
active = isBTC ? 0 : isGOLD ? 1 : isSILV ? 2 : isBIST ? 3 : -1

// ---- PAYLOAD-BEGIN (export_viz_payload.py — otomatik; elle düzenlemeyin)
a0_payloadMeta = "BTC · 2026-09 · 93 bar · capped P0xA0 · final sinyal: 1 · son bar 2026-09-16 08:00 UTC · UNTESTED-VIZ — dogruluk kaynagi DEGIL"
