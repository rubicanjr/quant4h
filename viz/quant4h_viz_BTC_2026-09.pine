swingLow  = array.from<float>(77000.00, 77000.00, 77000.00, 77000.00, 77000.00, 77000.00, 77000.00, 77000.00, 76420.00, 76420.00, 76420.00, 76420.00, 76264.00, 76264.00, 76264.00, 76264.00, 76264.00, 76264.00, 76264.00, 76264.00, 76264.00, 76264.00, 76264.00, 76264.00, 76264.00, 78660.00, 78660.00, 78660.00, 78660.00, 78660.00, 78660.00, 78660.00, 78660.00, 78660.00, 78660.00, 78660.00, 78660.00, 79233.00, 79233.00, 79233.00, 79233.00, 79233.00, 79233.00, 78680.00, 78680.00, 78680.00, 78680.00, 78680.00, 78680.00, 77620.01, 77620.01, 77620.01, 77620.01, 77620.01, 77620.01, 77620.01, 77620.01, 77620.01, 77620.01, 77620.01, 77620.01, 77620.01, 77620.01, 76464.00, 76464.00, 76464.00, 76464.00, 76046.58, 76046.58, 76046.58, 76046.58, 76046.58, 76046.58, 76046.58, 76046.58, 76046.58, 76046.58, 76046.58, 76500.00, 76500.00, 76500.00, 76500.00, 76388.72, 76388.72, 76388.72, 76388.72, 76388.72, 76388.72, 76388.72, 76388.72, 76388.72, 76388.72, 74967.97)
