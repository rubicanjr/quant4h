//@version=5
// ============================================================================
// quant4h — watch_only viz MULTI v3 (M21-DESCOPE, 2026-09-18, kullanıcı onaylı)
//
// TEK dosya, 4 gömülü payload bloğu + syminfo.ticker eşlemesi:
//   BTC   -> BTCUSDT (Binance spot)   GOLD -> GC1!/GC=F/XAUUSD
//   SILVER-> SI1!/SI=F/XAGUSD        BIST30 endeks -> XU030
// Eşleşmeyen sembolde çizim YOK + "payload yok" banner'ı.
//
// M21 DESCOPE: trade-review overlay TAMAMEN KALDIRILDI (trade dizileri,
// R etiketleri, kümülatif R, TRADE-REVIEW toggle). Trade geçmişi YALNIZ
// reports/trades_*.csv + reports/*.md + run_dash'ta (PINE_STYLE T14).
//
// KALAN: giriş/çıkış marker'ları (▲/✖ = sinyal kaydı) + EMA200 (toggle) +
// yapısal seviyeler (toggle) + watch_only + UNTESTED-VIZ banner (SABİT).
//
// strategy() YOK · alert YOK · Pine'da HESAP YOK (payload Python'dan gömülü).
// PAYLOAD UFKU: her --fetch'li cadence/§A koşusunda yenilenir; banner'da görünür.
// DOĞRULUK KAYNAĞI DEĞİLDİR (UNTESTED-VIZ) — kaynak: repo raporları/parquet'leri.
// ============================================================================
indicator("quant4h watch_only viz MULTI v3 [UNTESTED-VIZ]", overlay = true, max_labels_count = 100, max_lines_count = 100)

show_ema    = input.bool(false, "EMA200 (ihraç seri)", group = "quant4h")
show_levels = input.bool(false, "Yapisal seviyeler (swing/stop)", group = "quant4h")

// ---- sembol eşlemesi ----
tk     = syminfo.ticker
isBTC  = tk == "BTCUSDT" or tk == "BTCUSDT.BINANCE" or tk == "BINANCE:BTCUSDT"
isGOLD = tk == "GC1!" or tk == "GC=F" or tk == "XAUUSD" or tk == "GOLD"
isSILV = tk == "SI1!" or tk == "SI=F" or tk == "XAGUSD" or tk == "SILVER"
isBIST = tk == "XU030" or tk == "XU030.IS"
active = isBTC ? 0 : isGOLD ? 1 : isSILV ? 2 : isBIST ? 3 : -1

// ==== PAYLOAD-BEGIN (export_viz_payload.py — 4 blok; elle düzenlemeyin)
// M23: payload dizileri MAIN BODY'de TANIMLANMAZ; her dizi kendi
// fonksiyonunda sabit literaldir (Pine 'main body too long' çözümü, T15).
// ==== PAYLOAD-END

// ---- master diziler: aktif bloğu ilk barda kopyala ----
var int[]   m_ts   = array.new<int>()
var float[] m_ema  = array.new<float>()
var float[] m_stop = array.new<float>()
var float[] m_swl  = array.new<float>()
var float[] m_swh  = array.new<float>()
var float[] m_dh   = array.new<float>()
var float[] m_dl   = array.new<float>()
var int[]   m_sigL = array.new<int>()
var int[]   m_sigS = array.new<int>()
if barstate.isfirst
    if active == 0
        m_ts := f_a0_ts()
        m_ema := f_a0_ema200()
        m_stop := f_a0_stopLong()
        m_swl := f_a0_swingLow()
        m_swh := f_a0_swingHigh()
        m_dh := f_a0_donHigh()
        m_dl := f_a0_donLow()
        m_sigL := f_a0_sigLong()
        m_sigS := f_a0_sigShort()
    else if active == 1
        m_ts := f_a1_ts()
        m_ema := f_a1_ema200()
        m_stop := f_a1_stopLong()
        m_swl := f_a1_swingLow()
        m_swh := f_a1_swingHigh()
        m_dh := f_a1_donHigh()
        m_dl := f_a1_donLow()
        m_sigL := f_a1_sigLong()
        m_sigS := f_a1_sigShort()
    else if active == 2
        m_ts := f_a2_ts()
        m_ema := f_a2_ema200()
        m_stop := f_a2_stopLong()
        m_swl := f_a2_swingLow()
        m_swh := f_a2_swingHigh()
        m_dh := f_a2_donHigh()
        m_dl := f_a2_donLow()
        m_sigL := f_a2_sigLong()
        m_sigS := f_a2_sigShort()
    else if active == 3
        m_ts := f_a3_ts()
        m_ema := f_a3_ema200()
        m_stop := f_a3_stopLong()
        m_swl := f_a3_swingLow()
        m_swh := f_a3_swingHigh()
        m_dh := f_a3_donHigh()
        m_dl := f_a3_donLow()
        m_sigL := f_a3_sigLong()
        m_sigS := f_a3_sigShort()
hasPayload = active >= 0 and array.size(m_ts) > 1

// ---- seviye/ema indeksi ----
idx = -1
if hasPayload
    for i = 0 to array.size(m_ts) - 1
        if array.get(m_ts, i) == time
            idx := i
            break
f_val(array<float> a) =>
    hasPayload and idx >= 0 ? array.get(a, idx) : na
emaVal  = f_val(m_ema)
stopVal = f_val(m_stop)
swlVal  = f_val(m_swl)
swhVal  = f_val(m_swh)
dhVal   = f_val(m_dh)
dlVal   = f_val(m_dl)
sigL    = hasPayload and idx >= 0 ? array.get(m_sigL, idx) : 0
sigS    = hasPayload and idx >= 0 ? array.get(m_sigS, idx) : 0

plot(show_ema ? emaVal : na,     "EMA200 (ihraç)",      color = color.new(color.orange, 0), linewidth = 2)
plot(show_levels ? stopVal : na, "stop_long",           color = color.new(color.red, 25),   linewidth = 1, style = plot.style_stepline)
plot(show_levels ? swlVal : na,  "swing_low",           color = color.new(color.green, 50), linewidth = 1, style = plot.style_stepline)
plot(show_levels ? swhVal : na,  "swing_high",          color = color.new(color.teal, 50),  linewidth = 1, style = plot.style_stepline)
plot(show_levels ? dhVal : na,   "swing_high(20)",   color = color.new(color.gray, 60),  linewidth = 1, style = plot.style_circles)
plot(show_levels ? dlVal : na,   "swing_low(20)",    color = color.new(color.gray, 60),  linewidth = 1, style = plot.style_circles)

// ---- giriş/çıkış marker'ları (SİNYAL kaydı; trade geçmişi DEĞİL) ----
plotshape(sigL == 1 ? close : na, "AL koşulu oluştu (sinyal kaydı)", shape.triangleup,   location.absolute, color.new(color.lime, 0), size = size.tiny)
plotshape(sigS == 1 ? close : na, "SAT koşulu (sinyal kaydı)",       shape.xcross,       location.absolute, color.new(color.red, 0),  size = size.tiny)

// ---- SABİT banner ----
var table bn = table.new(position.top_right, 1, 4, border_width = 1)
if barstate.islastconfirmedhistory
    table.cell(bn, 0, 0, "quant4h watch_only MULTI v3 — UNTESTED-VIZ", text_color = color.white, bgcolor = color.new(color.red, 25), text_size = size.small)
    table.cell(bn, 0, 1, active >= 0 ? "payload: " + (active == 0 ? "BTC" : active == 1 ? "GOLD" : active == 2 ? "SILVER" : "BIST30-endeks") : "⚠ PAYLOAD YOK — bu sembol için gömülü payload yok (BTCUSDT/GC1!/SI1!/XU030)", text_color = active >= 0 ? color.silver : color.yellow, bgcolor = color.new(color.black, 40), text_size = size.tiny)
    table.cell(bn, 0, 2, "trade YOK · emir YOK · tavsiye YOK · marker'lar SİNYAL kaydıdır · trade geçmişi: reports/CSV/dash", text_color = color.silver, bgcolor = color.new(color.black, 40), text_size = size.tiny)
    table.cell(bn, 0, 3, "doğruluk kaynağı DEĞİL · payload ufku: son --fetch'li §A koşusu", text_color = color.silver, bgcolor = color.new(color.black, 40), text_size = size.tiny)
