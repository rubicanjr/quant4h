trR    = array.from<float>(2.16, 3.00, -0.50, 0.74, -1.00, -1.00, -1.00, 0.01, 1.51, 1.27, -1.00, 0.60, 2.11, -1.00, -1.00, -1.00, 0.55, -1.00, -0.39, -1.00, 3.00, 0.67, -0.45, 0.23, -0.02, 0.82, 3.00, 0.64, 3.00, -0.17, 3.00, -1.00, -0.36, -0.02, -0.50, 3.00, -1.00, -1.00, -1.00, 3.00, -1.00, -0.01, -1.00, 1.74, 2.07, -1.00, 3.00, -1.00, -1.00, 3.00, 0.16, -1.00, -1.00, -1.00, -1.00, 3.00, -1.00, -0.37, -1.00, -1.00, -1.00, 2.28, 2.52, 0.59, 0.24, 3.00, 3.00, -1.00, 3.00, -1.00, 0.81, 1.23, -1.00, -1.00, 1.07, -1.00, 0.84, 0.06, 1.05, 0.09, -1.00, 3.00, -1.00, -0.68, 0.44, 1.08, 3.00, -0.58, -1.00, -1.00, -0.43, -0.43, 1.01, 3.00, -1.00, 3.00, -1.00, -1.00, -0.42, -1.00, 0.33, -1.00, -0.67, -1.00, -1.00, -1.00, 0.02, -1.00, -1.00, -1.00, -1.00, 3.00, -1.00, 0.79, -1.00, -0.20, -1.00, -1.00, -0.06, -1.00, 0.92, -1.00, -1.00, 3.00, -1.00, -1.00, 0.18, 3.00, 1.38, 3.00, 0.60, -1.00, -0.68, 3.00, 3.00, -0.11, 0.12, -1.00, 0.16, -1.00, 1.17, -1.00, -0.06, -1.00, -1.00, -0.21, -1.00, 1.10, 2.33, 0.59, -1.00, -1.00, -1.00, -1.00, -1.00, 0.08, 3.00, -0.45, -0.19, 1.78, 3.00, -1.00, -1.00, -1.00, -1.00, 1.73, -1.00, -1.00, -1.00, -1.00, -1.00, 1.36, 0.06, 0.51, -0.27, 3.00, -0.18, -1.00, -0.46, -1.00, 0.53, -0.04, 3.00, 0.03, -0.36, 2.52, -1.00)
// ---- PAYLOAD-END
// ---------------------------------------------------------------------------

hasPayload = payloadOK and array.size(ts) > 1

// bar.time -> payload indeksi (payload <= ~250 satir: dogrusal arama yeterli)
idx = -1
if hasPayload
    for i = 0 to array.size(ts) - 1
        if array.get(ts, i) == time
            idx := i
            break

f_val(array<float> a) =>
    hasPayload and idx >= 0 ? array.get(a, idx) : na

emaVal      = f_val(ema200)
stopVal     = f_val(stopLong)
swLowVal    = f_val(swingLow)
swHighVal   = f_val(swingHigh)
donHighVal  = f_val(donHigh)
donLowVal   = f_val(donLow)
sigL        = hasPayload and idx >= 0 ? array.get(sigLong, idx) : 0
sigS        = hasPayload and idx >= 0 ? array.get(sigShort, idx) : 0
sigPx       = f_val(sigPrice)

plot(show_ema ? emaVal : na,            "EMA200 (ihraç)",        color = color.new(color.orange, 0),  linewidth = 2)
plot(show_levels ? stopVal : na,        "stop_long (yapısal)",   color = color.new(color.red, 20),      linewidth = 1, style = plot.style_stepline)
plot(show_levels ? swLowVal : na,       "swing_low (onaylı)",    color = color.new(color.green, 45),    linewidth = 1, style = plot.style_stepline)
plot(show_levels ? swHighVal : na,      "swing_high (onaylı)",   color = color.new(color.teal, 45),     linewidth = 1, style = plot.style_stepline)
plot(show_levels ? donHighVal : na,     "donchian_high(20)",     color = color.new(color.gray, 55),     linewidth = 1, style = plot.style_circles)
plot(show_levels ? donLowVal : na,      "donchian_low(20)",      color = color.new(color.gray, 55),     linewidth = 1, style = plot.style_circles)

// Marker'lar KARAR barının KAPANIŞINDA çizilir (sinyal barı = t; icra open[t+1]
// PİNE'DA GÖSTERİLMEZ — icra temsili yoktur).
plotshape(show_markers and sigL == 1 ? sigPx : na, "LONG kararı (capped)",  shape.triangleup,   location.absolute, color.new(color.green, 0), size = size.small)
plotshape(show_markers and sigS == 1 ? sigPx : na, "SHORT kararı (capped)", shape.triangledown, location.absolute, color.new(color.red, 0),   size = size.small)

// ---- bilgi tablosu (her zaman görünür) ----
var table infoTbl = table.new(position.top_right, 1, 4, border_width = 1)
if barstate.islastconfirmedhistory
    table.cell(infoTbl, 0, 0, "quant4h watch_only — UNTESTED-VIZ", text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small)
    table.cell(infoTbl, 0, 1, hasPayload ? payloadMeta : "⚠ " + payloadMeta, text_color = hasPayload ? color.silver : color.yellow, bgcolor = color.new(color.black, 40), text_size = size.tiny)
    table.cell(infoTbl, 0, 2, "Doğruluk kaynağı DEĞİLDİR · kaynak: repo (reports/data)", text_color = color.silver, bgcolor = color.new(color.black, 40), text_size = size.tiny)
    table.cell(infoTbl, 0, 3, "trade YOK · emir YOK · tavsiye YOK · icra: open[t+1] (burada gösterilmez)", text_color = color.silver, bgcolor = color.new(color.black, 40), text_size = size.tiny)
